{
  "manifest_version": 3,
  "name": "AI ROUND TABLE",
  "version": "1.0.49",
  "description": "Relay messages between ChatGPT, Gemini, and DeepSeek conversations in your browser.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AI ROUND TABLE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/core.js",
        "vendor/marked/marked.min.js",
        "content/markdown-identity.js",
        "content/relay-history.js",
        "content/dom-text.js",
        "content/common.js",
        "content/chatgpt-reader.js",
        "content/chatgpt.js",
        "content/bookmark-model.js",
        "content/bookmark-picker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/core.js",
        "vendor/marked/marked.min.js",
        "content/markdown-identity.js",
        "content/relay-history.js",
        "content/dom-text.js",
        "content/common.js",
        "content/gemini.js",
        "content/bookmark-model.js",
        "content/bookmark-picker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "shared/core.js",
        "content/dom-text.js",
        "content/common.js",
        "content/deepseek.js",
        "content/bookmark-model.js",
        "content/bookmark-picker.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
